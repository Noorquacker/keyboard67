@@ -182,6 +182,10 @@ IR::Block A32AddressSpace::GenerateIR(IR::LocationDescriptor descriptor) const {
 }
 
 void A32AddressSpace::InvalidateCacheRanges(const boost::icl::interval_set<u32>& ranges) {
+    if (!conf.track_code_ranges) {
+        ClearCache();
+        return;
+    }
     InvalidateBasicBlocks(block_ranges.InvalidateRanges(ranges));
 }
 
@@ -417,6 +421,9 @@ EmitConfig A32AddressSpace::GetEmitConfig() {
 void A32AddressSpace::RegisterNewBasicBlock(const IR::Block& block, const EmittedBlockInfo&) {
     const A32::LocationDescriptor descriptor{block.Location()};
     const A32::LocationDescriptor end_location{block.EndLocation()};
+    if (!conf.track_code_ranges) {
+        return;
+    }
     const auto range = boost::icl::discrete_interval<u32>::closed(descriptor.PC(), end_location.PC() - 1);
     block_ranges.AddRange(range, descriptor);
 }
